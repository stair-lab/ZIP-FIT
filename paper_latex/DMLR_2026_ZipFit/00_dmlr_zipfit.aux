\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {\texttt  {ZIP-FIT} selects task-specific data for efficient finetuning.} (0) Obtain both the source and target datasets. (1) Calculate \texttt  {ZIP-FIT} Alignment of each source example with the target dataset using \texttt  {gzip} compression. (2) Rank all source examples based on these alignment scores. (3) Select the top-K most aligned examples for fine-tuning. (4) Fine-tune a large language model using the selected top-K examples to improve performance on the target task.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:zip-fit-vs-baselines}{{1}{2}{\textbf {\texttt {ZIP-FIT} selects task-specific data for efficient finetuning.} (0) Obtain both the source and target datasets. (1) Calculate \texttt {ZIP-FIT} Alignment of each source example with the target dataset using \texttt {gzip} compression. (2) Rank all source examples based on these alignment scores. (3) Select the top-K most aligned examples for fine-tuning. (4) Fine-tune a large language model using the selected top-K examples to improve performance on the target task}{figure.1}{}}
