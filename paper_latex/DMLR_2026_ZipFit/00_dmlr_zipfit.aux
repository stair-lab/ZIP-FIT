\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Higher \texttt  {ZIP-FIT} alignment correlates with lower cross-entropy loss.} The relationship between \texttt  {ZIP-FIT} alignment and cross-entropy (CE) loss for (a) GPT-2 trained on 22k tokens ($R^2 = 0.90, p=0.001$) and (b) Mistral7B trained on 22k tokens ($R^2 = 0.75, p=0.025$). Each point represents a dataset, with its position reflecting the dataset’s \texttt  {ZIP-FIT} alignment score against the ProofNet test set and the resulting CE loss. The dashed red line indicates the linear regression fit, while the dashed grey line shows the pretrained CE loss. Higher alignment scores correspond to lower CE losses, demonstrating that training on better aligned data yields better performance.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:ce_vs_gzip_align}{{3}{5}{\textbf {Higher \texttt {ZIP-FIT} alignment correlates with lower cross-entropy loss.} The relationship between \texttt {ZIP-FIT} alignment and cross-entropy (CE) loss for (a) GPT-2 trained on 22k tokens ($R^2 = 0.90, p=0.001$) and (b) Mistral7B trained on 22k tokens ($R^2 = 0.75, p=0.025$). Each point represents a dataset, with its position reflecting the dataset’s \texttt {ZIP-FIT} alignment score against the ProofNet test set and the resulting CE loss. The dashed red line indicates the linear regression fit, while the dashed grey line shows the pretrained CE loss. Higher alignment scores correspond to lower CE losses, demonstrating that training on better aligned data yields better performance}{figure.3}{}}
