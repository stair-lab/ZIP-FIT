\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {\texttt  {ZIP-FIP} demonstrates lower cross-entropy and lower run time during data selection than competing DSIR and D4 methods.} \texttt  {ZIP-FIT} is cheaper, faster, and better performing. The run times do no include fine-tuning time, since it’s a constant offset across all models. D4's data selection (not shown) takes 5hs because it uses an embedding model (opt-125m \cite  {opt}), the same one as the original paper \cite  {d4}. }}{27}{figure.9}\protected@file@percent }
\newlabel{fig:profiling_run_times}{{9}{27}{\textbf {\texttt {ZIP-FIP} demonstrates lower cross-entropy and lower run time during data selection than competing DSIR and D4 methods.} \texttt {ZIP-FIT} is cheaper, faster, and better performing. The run times do no include fine-tuning time, since it’s a constant offset across all models. D4's data selection (not shown) takes 5hs because it uses an embedding model (opt-125m \cite {opt}), the same one as the original paper \cite {d4}}{figure.9}{}}
