\@writefile{toc}{\contentsline {section}{\numberline {E}Impact of Compression Algorithms and Levels}{25}{appendix.E}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Lighter compression preserves crucial information for data selection.} At minimum compression levels, both gzip and LZ4 achieve the strongest Pass@1 scores (11.58\% and 12.19\%), significantly outperforming the base model (6.09\%, dashed line). Performance systematically degrades with increased compression across all algorithms, suggesting that aggressive compression removes valuable alignment signals.}}{25}{figure.8}\protected@file@percent }
\newlabel{fig:compression_comparison}{{8}{25}{\textbf {Lighter compression preserves crucial information for data selection.} At minimum compression levels, both gzip and LZ4 achieve the strongest Pass@1 scores (11.58\% and 12.19\%), significantly outperforming the base model (6.09\%, dashed line). Performance systematically degrades with increased compression across all algorithms, suggesting that aggressive compression removes valuable alignment signals}{figure.8}{}}
